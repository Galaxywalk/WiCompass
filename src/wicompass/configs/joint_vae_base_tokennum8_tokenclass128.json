{
  "seed": 42,
  "data": {
    "preproc_root": "datasets/AMASS_preproc",
    "train_ratio": 0.9,
    "supported_datasets": [
      "HuMMan",
      "KIT",
      "BMLmovi",
      "BMLrub",
      "CMU",
      "MOYO",
      "GRAB",
      "MoSh",
      "PosePrior",
      "WEIZMANN",
      "MMBody"
    ],
    "datasets": [
      "KIT",
      "BMLmovi",
      "BMLrub",
      "CMU",
      "MOYO",
      "GRAB",
      "MoSh",
      "PosePrior",
      "WEIZMANN"
    ]
  },
  "model": {
    "num_joints": 22,
    "input_dim": 3,
    "enc_num_blocks": 4,
